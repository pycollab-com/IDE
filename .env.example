SECRET_KEY=change-me
DATABASE_URL=sqlite:///server/app.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Browser runtime (Pyodide)
PYCOLLAB_PYODIDE_VERSION=0.29.3
PYCOLLAB_PYODIDE_BASE_URL=https://cdn.jsdelivr.net/pyodide/v0.29.3/full/
PYCOLLAB_PYODIDE_ALLOWED_PACKAGES=
PYCOLLAB_PYODIDE_MAX_RUN_SECONDS=0
# Required for full interactive runtime (blocking input/interrupt semantics).
PYCOLLAB_ENABLE_CROSS_ORIGIN_ISOLATION=true
# Optional: absolute path for persistent uploads (e.g. Railway volume mount)
PYCOLLAB_UPLOADS_DIR=

# Optional admin bootstrap (set both to enable)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_PROMOTE=false

# Rate limits and payload limits
AUTH_RATE_LIMIT_PER_MINUTE=10
PROJECT_RATE_LIMIT_PER_MINUTE=60
SOCKET_RATE_LIMIT_PER_SECOND=20
MAX_PROFILE_PICTURE_BYTES=1048576
MAX_WS_PAYLOAD_BYTES=200000

# AI Coding Assistant (OpenAI-compatible API)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google OAuth (Web client ID; set both to the same value)
GOOGLE_OAUTH_CLIENT_ID=673654005602-gecd1ltp10rttmh177k0onqignmcofag.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=673654005602-gecd1ltp10rttmh177k0onqignmcofag.apps.googleusercontent.com
# Optional: minutes before google signup completion token expires (default 15)
GOOGLE_SIGNUP_TOKEN_EXPIRE_MINUTES=15

# Client build-time API base (optional)
VITE_API_BASE=

# Passkey / WebAuthn (optional – derived from request Host header when unset)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=PyCollab
WEBAUTHN_RP_ORIGIN=
