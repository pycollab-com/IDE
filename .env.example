# Optional local overrides for the offline IDE branch

# Override the local app data directory.
PYCOLLAB_IDE_HOME=

# Override the Python executable used by the Electron shell.
PYCOLLAB_IDE_PYTHON=

# Browser runtime (Pyodide)
PYCOLLAB_PYODIDE_VERSION=0.29.3
PYCOLLAB_PYODIDE_BASE_URL=/vendor/pyodide/v0.29.3/full/
PYCOLLAB_PYODIDE_ALLOWED_PACKAGES=
PYCOLLAB_PYODIDE_MAX_RUN_SECONDS=0
PYCOLLAB_ENABLE_CROSS_ORIGIN_ISOLATION=true

# Hosted PyCollab service used by the desktop app
VITE_HOSTED_WEB_BASE=https://pycollab.com
VITE_HOSTED_API_BASE=https://pycollab.com

# Hosted service configuration used by tests and direct server development
SECRET_KEY=
DATABASE_URL=sqlite:///server/app.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PYCOLLAB_UPLOADS_DIR=
AUTH_RATE_LIMIT_PER_MINUTE=10
PROJECT_RATE_LIMIT_PER_MINUTE=60
JOIN_CODE_RATE_LIMIT_PER_MINUTE=10
SOCKET_RATE_LIMIT_PER_SECOND=20
MAX_PROFILE_PICTURE_BYTES=1048576
MAX_WS_PAYLOAD_BYTES=200000
TRUSTED_PROXY_CIDRS=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_SIGNUP_TOKEN_EXPIRE_MINUTES=15
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=PyCollab
WEBAUTHN_RP_ORIGIN=
